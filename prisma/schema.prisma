
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Holding{
  id Int @id @default(autoincrement())
  symbol String
  shares Float
  author User @relation(fields: [authorId], references: [id])
  authorId Int
}

model User {
  id             Int       @id @default(autoincrement())
  name           String?
  email          String    @unique
  password       String
  dateOfBirth    DateTime?
  monthlyIncome  Float?
  profilePicture String?
  expenses       Expense[]
  incomes        Income[]
  budgets        Budget[]
  holdings       Holding[]
}

model Expense {
  id          Int      @id @default(autoincrement())
  amount      Float
  category    String
  description String?
  date        DateTime
  author      User     @relation(fields: [authorId], references: [id])
  authorId    Int
}

model Income {
  id          Int      @id @default(autoincrement())
  amount      Float
  category    String
  description String?
  date        DateTime
  author      User     @relation(fields: [authorId], references: [id])
  authorId    Int
}

enum BudgetType {
  INCOME
  EXPENSE
}

model Budget {
  id       Int        @id @default(autoincrement())
  type     BudgetType
  category String
  target   Float
  author   User       @relation(fields: [authorId], references: [id])
  authorId Int

  @@unique([authorId, type, category])
}
