
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id       Int       @id @default(autoincrement())
  name     String?
  email    String    @unique
  password String
  dateOfBirth DateTime?
  monthlyIncome Float?
  profilePicture String?
  expenses Expense[]
  holdings Holding[]
}

model Expense {
  id          Int      @id @default(autoincrement())
  amount      Float
  category    String
  description String?
  date        DateTime
  author      User     @relation(fields: [authorId], references: [id])
  authorId    Int
}

model Holding{
  id Int @id @default(autoincrement())
  symbol String
  shares Float
  author User @relation(fields: [authorId], references: [id])
  authorId Int
}